  "options": {
    "step": {
      "init": {
        "title": "Floorplan background",
        "description": "Optionally show a house floorplan image as the background of the cleaning map. Place a PNG/JPG on the Home Assistant machine and enter its absolute path, then calibrate origin, rotation and scale so the robot's path aligns with the walls.",
        "data": {
          "floorplan_image": "Floorplan image path (absolute)",
          "floorplan_origin_x": "Origin X (metres)",
          "floorplan_origin_y": "Origin Y (metres)",
          "floorplan_rotation": "Rotation (degrees)",
          "floorplan_scale": "Scale (pixels per metre)"
        },
        "data_description": {
          "floorplan_image": "Absolute path to a local PNG/JPG, e.g. /config/floorplan.png. Leave empty to disable the background and use the default dark map.",
          "floorplan_origin_x": "World X (metres, robot frame) where the floorplan image's bottom-left corner is anchored.",
          "floorplan_origin_y": "World Y (metres, robot frame) where the floorplan image's bottom-left corner is anchored.",
          "floorplan_rotation": "Rotate the floorplan around its anchor (degrees, clockwise).",
          "floorplan_scale": "How many floorplan-image pixels represent one metre."
        }
      }
    },
    "error": {
      "path_must_be_absolute": "The floorplan image path must be absolute (start with /).",
      "path_not_found": "No file at that path on the Home Assistant machine. Check the path and that the file is readable."
    }
  },
  "issues": {
    "unsupported_firmware": {
      "title": "Unsupported OpenNeato firmware",
      "description": "The bridge at {host} reports firmware {version} from {repository}. This integration is built for the Leicas/OpenNeato fork firmware ({min_version} or newer); upstream or older firmware may miss endpoints, and heavy polling can make the ESP32 unresponsive. Flash the fork firmware from {releases_url}."
    }
  },
  "services": {
    "start_mapping_run": {
      "name": "Start mapping run",
      "description": "Map the floor with a quiet house clean (Eco on); the result is merged and saved as a floor plan. The robot's own exploration run needs the Neato cloud and is not used."
    },
    "save_floor_plan": {
      "name": "Save floor plan",
      "description": "Save the current floor plan under a name (default: the date and time).",
      "fields": {
        "name": {
          "name": "Name",
          "description": "Name of the saved floor plan. Saving under an existing name replaces it."
        }
      }
    },
    "restore_floor_plan": {
      "name": "Restore floor plan",
      "description": "Replace the current floor plan with a saved one.",
      "fields": {
