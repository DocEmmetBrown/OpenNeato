          "name": "Name",
          "description": "Name of the saved floor plan."
        }
      }
    },
    "delete_floor_plan": {
      "name": "Delete floor plan",
      "description": "Forget a saved floor plan. The current floor plan is kept.",
      "fields": {
        "name": {
          "name": "Name",
          "description": "Name of the saved floor plan."
        }
      }
    },
    "reset_floor_plan": {
      "name": "Reset floor plan",
      "description": "Start the floor plan again from scratch. Saved floor plans are kept."
    },
    "manual_move": {
      "name": "Manual move",
      "description": "Drive the wheels by a distance while manual mode is on (ESPHome firmware). The robot stops on its own after 5 s without a move, on a bumper hit, a lifted wheel or a stall.",
      "fields": {
        "left_mm": {
          "name": "Left wheel",
          "description": "Distance for the left wheel, negative to reverse."
        },
        "right_mm": {
          "name": "Right wheel",
          "description": "Distance for the right wheel, negative to reverse."
        },
        "speed": {
